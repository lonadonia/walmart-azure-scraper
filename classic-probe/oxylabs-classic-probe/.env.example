# PLACEHOLDERS ONLY. This build reads neither variable: its live mode is disabled, and no offline command
# (help, plan, validate, campaign-init, status, confirm-charge, export, replay, live) reads a credential.
# A later, separately approved version would read the Classic account's API user from these, never from a file
# in the delivery.
OXYLABS_CLASSIC_USERNAME=<api-username-placeholder>
OXYLABS_CLASSIC_PASSWORD=<api-password-placeholder>
