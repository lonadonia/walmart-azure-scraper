+def category_page(nd: Mapping[str, Any]) -> str:
+    """The address of the category page the document is, as its own data states it, or "" when it is not one.
+
+    A Walmart category page is the Next.js page ``/cp/[...categoryParams]``; its ``props.pageProps.pageUrl``
+    is the address it was served as (``/cp/flower-shop/5098771``, without the query). On 2026-11-03 the Food
+    navigation's listing link "Fresh Flowers" (``/browse/food/flowers/976759_1089004_2424807``) served the
+    category page "Flower Shop" (``/cp/flower-shop/5098771``): links to other listings, no result grid."""
+    route = text(nd.get("page"))
+    if not route.startswith("/cp/"):
+        return ""
+    served = text(get(nd, "props", "pageProps", "pageUrl")).split("?", 1)[0]
+    return served if served.startswith("/cp/") else route
+
