+            hard_end_s=HARD_END_S,
+            manifest=manifest,
+            out_dir=out,
+            retailer="walmart",
+            cwd=ROOT,
+        )
+    facts = {
+        "status": getattr(session, "status", None),
+        "tree": session.tree,
+        "evidence": session.evidence,
+        "problems": session.problems,
+    }
+    show(facts)
+    assert facts["status"] == "ok" and session.recovery == {}, facts
