+    assert run.status == "validated"  # the run itself is good: only its publication was refused
+    refused = [x for x in lines if x["event"] == "PUBLICATION_REFUSED"]
+    assert len(refused) == 1 and refused[0]["level"] == "ERROR", refused
+    assert "did not come from the network" in json.dumps(refused[0])
+    finished = [x for x in lines if x["event"] == "RUN_FINISHED"][-1]
+    assert code == 6 and finished["exit_code"] == 6 and finished["level"] == "WARN", finished
+    assert finished["publication"]["published"] is False
+    assert "did not come from the network" in finished["publication"]["refused"]
+    with sessionmaker(env.engine)() as s:
+        recorded = list(
