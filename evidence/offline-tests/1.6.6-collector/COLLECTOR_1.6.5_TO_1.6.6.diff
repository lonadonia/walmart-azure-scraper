+def test_a_scheduled_run_whose_publication_was_refused_exits_6_also_on_azures_retry(env: Env) -> None:
+    """Release 1.6.6: Azure retries a failed replica once (``replicaRetryLimit`` 1). The retry finds the
+    occurrence done and sends nothing; it must still exit 6, or the execution would end as a success."""
+    settings = env.config.parent / "settings.yaml"
+    text = settings.read_text(encoding="utf-8")
+    settings.write_text(
+        text.replace("publication: { test_target: true }", "publication: { test_target: false }"),
+        encoding="utf-8",
+    )
+    env.edit(schedule={"enabled": True, "weekdays": [1], "start_time": "06:00"})
+    summer = datetime(2026, 7, 14, tzinfo=UTC)
+    assert _scheduled(env, summer.replace(hour=11)) == 6
+    [run] = env.runs()
+    assert run.status == "validated" and run.trigger == "schedule"
+    calls = len(env.mock.calls)
+    assert (
+        _scheduled(env, summer.replace(hour=11, minute=10)) == 6
+    )  # Azure's retry: done, still not published
+    assert len(env.runs()) == 1 and len(env.mock.calls) == calls  # nothing was collected again
+    assert not (env.data / "published" / STORE_KEY / "latest.json").exists()
