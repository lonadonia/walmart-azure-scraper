+def use_gate(monkeypatch: pytest.MonkeyPatch, gate: FakeGate, mock: MockOxylabs) -> None:
+    gate.mock = mock
+    monkeypatch.setattr(oxylabs.OxylabsTransport, "account_gate_factory", lambda: gate)
