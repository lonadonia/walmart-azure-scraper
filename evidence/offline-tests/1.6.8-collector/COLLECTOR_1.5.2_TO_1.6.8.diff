+    2026-11-04 (live L6, run 01M6K25T57WW4BJBJ3RQGWN26G, fetch 01M6K2F80M1AFY26P6BMN56F4C): minified, its page
+    data written with the id unquoted (``<script id=__NEXT_DATA__ type="application/json">``), its route the
+    Next.js page ``/404``, an error section and "Uh-oh... This page could not be found." A SYNTHETIC copy with
+    those markers; its page data is cut to the route and an empty ``pageProps``."""
+    script = next_data_script({"page": "/404", "query": {}, "props": {"pageProps": {}}}).replace(
+        'id="__NEXT_DATA__"', "id=__NEXT_DATA__"
+    )
+    return (
+        "<!DOCTYPE html><html lang=en-US><head><meta charset=utf-8 /></head><body>"
+        '<section data-dca-id="404" data-dca-type="error"><h1>Uh-oh...</h1>'
+        "<p>This page could not be found.</p><a href=/>Return to home</a></section>"
+        f"{script}</body></html>"
+    )
diff --git a/tests/unit/test_completeness_167.py b/tests/unit/test_completeness_167.py
new file mode 100644
index 0000000..d9f663b
--- /dev/null
+++ b/tests/unit/test_completeness_167.py
@@ -0,0 +1,90 @@
+"""Release 1.6.7: a partition is complete only when every child category ended complete, and a CSV row read
+in part is never complete (the client's review of 1.6.6: moving totals, repeated or wrong pages, missing
+children and unresolved result windows keep the affected row incomplete). SYNTHETIC listings."""
+
+from __future__ import annotations
+
+import pytest
+
+from walmart_headless.collection import walmart
+from walmart_headless.collection.walmart import Listing, listing_outcomes
+
+
+def partition(child_status: str, child_end: str = "", reason: str = "") -> list[Listing]:
+    """Diapering (4 reported) and two child categories whose distinct products are exactly its 4."""
+    parent = Listing("Diapering", "u", "5427_486190", status="PARTITIONED", total=4, seen=["a", "b"])
+    child1 = Listing(
+        "Diapers", "u1", "5427_486190_1", status="DONE", total=3, seen=["a", "c"], parent=parent.id, depth=1
+    )
+    child2 = Listing(
+        "Wipes",
+        "u2",
+        "5427_486190_2",
+        status=child_status,
+        total=2,
+        seen=["c", "d"],
+        parent=parent.id,
+        depth=1,
+        end=child_end,
+        reason=reason,
+    )
+    return [parent, child1, child2]
+
+
+def test_a_partition_whose_children_all_ended_complete_and_balance_is_complete() -> None:
+    [out] = listing_outcomes(partition("DONE", "LAST_PAGE"))
+    assert (out["status"], out["distinct_with_children"], out["difference"]) == ("DONE", 4, 0)
+
+
+@pytest.mark.parametrize(
+    ("end", "reason"),
+    [
+        ("LAST_PAGE", "the reported total changed while the listing was read ([139, 137, 138])"),
+        ("REPEATED_PAGE", "result page 3 repeated page 2"),
+        ("IDENTITY", "the listing's own page does not place it under 5427_486190"),
+        ("RESULT_WINDOW", "the site served 1,000 of 1,400 results; not partitioned: no child category"),
+    ],
+    ids=["moving-total", "repeated-page", "wrong-page", "result-window"],
+)
+def test_a_child_that_did_not_end_complete_keeps_the_partition_incomplete_even_when_identities_balance(
+    end: str, reason: str
+) -> None:
+    """1.6.6 called this partition DONE: its distinct products balance its total exactly, and no child was
+    still being read. A child that ended incomplete is evidence the listing's products were not all read
+    reliably; the partition stays incomplete and names the child."""
+    [out] = listing_outcomes(partition("INCOMPLETE", end, reason))
+    assert out["difference"] == 0  # the identities balance ...
+    assert out["status"] == "INCOMPLETE"  # ... and the partition is still not complete
+    assert "Wipes INCOMPLETE" in out["reason"] and f"({end})" in out["reason"], out["reason"]
+
+
+def test_a_child_left_by_a_limit_of_the_run_makes_the_partition_capped() -> None:
+    [out] = listing_outcomes(partition("CAPPED", "PAGE_LIMIT", "page limit of this run (1) reached"))
+    assert out["status"] == "CAPPED"
+
+
+def test_a_partitioned_child_with_no_child_category_of_its_own_is_not_complete() -> None:
+    listings = partition("PARTITIONED")
+    [out] = listing_outcomes(listings)
+    assert out["status"] == "INCOMPLETE" and "Wipes PARTITIONED" in out["reason"], out
+
+
+def test_a_partition_with_no_child_recorded_is_not_complete() -> None:
+    parent = Listing("Diapering", "u", "5427_486190", status="PARTITIONED", total=2, seen=["a", "b"])
+    [out] = listing_outcomes([parent])
+    assert out["status"] == "INCOMPLETE" and "no child category" in out["reason"]
+
+
+def test_a_row_read_through_configured_listings_or_with_listings_not_chosen_is_read_in_part() -> None:
+    configured = Listing("Fabric Softeners", "u", "1115193_1071967_1630538", status="DONE", via="configured")
+    assert "category page, which names its other listings, was not read" in walmart.row_read_in_part(
+        [configured]
+    )
+    chosen = Listing("Milk", "u1", "976759_9176907", status="DONE", via="category_page")
+    left = Listing(
+        "Snacks", "u2", "976759_976787", status="SKIPPED", note=walmart.NOT_CHOSEN, via="category_page"
+    )
+    csv_note = "excluded by the client's CSV"
+    excluded = Listing("Recipes", "u3", "976759_1", status="SKIPPED", note=csv_note, via="category_page")
+    assert walmart.row_read_in_part([chosen, left, excluded]).startswith("1 of the 3 listings")
+    assert walmart.row_read_in_part([chosen, excluded]) == ""  # an exclusion of the client's CSV is not a gap
diff --git a/tests/unit/test_empty_pickup_grid.py b/tests/unit/test_empty_pickup_grid.py
new file mode 100644
index 0000000..4b2e5d2
--- /dev/null
+++ b/tests/unit/test_empty_pickup_grid.py
@@ -0,0 +1,97 @@
+"""Release 1.6.4: a listing total the page reports as 0 is a total of 0.
+
+Live L7 of 2026-11-04 (run 01M6K7HT3XVV8R8CX79P31KMB4, release 1.6.3): Walmart's "Bidets" listing for store
+3891 answered with an empty Pickup result grid (``aggregatedCount`` 0) next to an "Available for shipping"
+carousel of 10 products (``searchResult.count`` 10). Release 1.6.3 read the listing's total as
+``aggregatedCount or count``: it took the 0 for a missing value and the carousel's 10 for the total, and
+stopped the run ("the page reports results but shows no product"). The authentic page is
+``tests/captures/listing_pages_20261104``; the other pages here are SYNTHETIC."""
+
+from __future__ import annotations
+
+import gzip
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests import synthetic_walmart as syn
+from walmart_headless.sites.walmart import page_data as wpd
+
+PAGES = Path(__file__).resolve().parents[1] / "captures" / "listing_pages_20261104"
+
+
+def page(name: str) -> dict[str, Any]:
+    return wpd.next_data(gzip.decompress((PAGES / name).read_bytes()).decode("utf-8"))
+
+
+def shape(nd: dict[str, Any]) -> tuple[Any, ...]:
+    pag = wpd.pagination(nd)
+    loc = wpd.page_location(nd)
+    return (
+        (pag.total_count, pag.page_count, pag.max_page),
+        [(s.layout, s.products, s.primary, s.fulfillment_filter) for s in wpd.item_stacks(nd)],
+        len(wpd.page_items(nd)),
+        wpd.placements(nd),
+        (loc.store_id, loc.intent) if loc else None,
+    )
+
+
+def test_the_fixture_matches_its_manifest() -> None:
+    for entry in json.loads((PAGES / "MANIFEST.json").read_text("utf-8")):
+        data = (PAGES / entry["file"]).read_bytes()
+        assert hashlib.sha256(data).hexdigest() == entry["source_sha256"], entry["file"]
+        assert hashlib.sha256(gzip.decompress(data)).hexdigest() == entry["content_sha256"], entry["file"]
+
+
+def test_the_live_bidets_page_reports_a_total_of_zero_not_the_count_of_its_carousel() -> None:
+    nd = page("bidets_page1.html.gz")
+    pag = wpd.pagination(nd)
+    assert (pag.total_count, pag.page_count, pag.max_page) == (0, 10, 0)
+    assert [
+        (s.layout, s.title, s.count, s.products, s.primary, s.fulfillment_filter) for s in wpd.item_stacks(nd)
+    ] == [
+        ("GRID", 'Results for "bidets"', 0, 0, True, "Pickup"),
+        ("CAROUSEL", "Available for shipping", 838, 10, False, "Shipping"),
+    ]
+    assert wpd.page_items(nd) == [] and wpd.placements(nd) == 0  # the carousel's products are not results
+    loc = wpd.page_location(nd)
+    assert loc is not None and (loc.store_id, loc.postal_code, loc.intent) == ("3891", "60085", "PICKUP")
+
+
+@pytest.mark.parametrize(
+    ("search_result", "total"),
+    [
+        ({"aggregatedCount": 0, "count": 10}, 0),
+        ({"aggregatedCount": "0", "count": 10}, 0),
+        ({"aggregatedCount": 25, "count": 10}, 25),
+        ({"count": 10}, 10),
+        ({"aggregatedCount": None, "count": 10}, 10),
+        ({"aggregatedCount": 0, "count": 0}, 0),
+    ],
+    ids=[
+        "zero-beside-a-carousel",
+        "zero-written-as-text",
+        "a-total-above-zero",
+        "no-aggregated-count",
+        "a-null-aggregated-count",
+        "zero-and-no-product",
+    ],
+)
+def test_a_reported_zero_is_the_total_and_count_is_read_only_without_one(
+    search_result: dict[str, Any], total: int
+) -> None:
+    nd = {"props": {"pageProps": {"initialData": {"searchResult": search_result}}}}
+    assert wpd.pagination(nd).total_count == total
+
+
+def test_the_synthetic_copy_has_the_shape_of_the_live_page() -> None:
+    carousel = [
+        syn.Item(str(7000 + i), f"Synthetic Shipping Product {i}", "$9.99", lines=(("SHIPPING", "0"),))
+        for i in range(10)
+    ]
+    assert shape(wpd.next_data(syn.empty_pickup_grid_page(carousel, store="3891"))) == shape(
+        page("bidets_page1.html.gz")
+    )
diff --git a/tests/unit/test_exports_policy.py b/tests/unit/test_exports_policy.py
new file mode 100644
index 0000000..2d5b506
--- /dev/null
+++ b/tests/unit/test_exports_policy.py
@@ -0,0 +1,49 @@
+"""Release 1.6.0: the final output boundary. Both products writers (JSON and CSV, used for products.* and
+products_fresh.* of every run, replay and edition) refuse a row holding a Walmart deal value, a 23rd field,
+a wrong order or a non-string, so no branch can reintroduce one into a file."""
+
+from __future__ import annotations
+
+import pytest
+
+from walmart_headless.core.schema import DEAL_FIELDS, OUTPUT_FIELDS, build_record
+from walmart_headless.publishing.exports import canonical_products_bytes, products_csv_bytes
+
+
+def row() -> dict[str, str]:
+    return build_record(
+        {
+            "product_title": "Synthetic, 12 oz",
+            "url": "https://www.walmart.com/ip/x/9001",
+            "category": "Food",
+            "regular_price": "1.99",
+            "crawl_date": "2026-11-03",
+        }
+    )
+
+
+@pytest.mark.parametrize("writer", [canonical_products_bytes, products_csv_bytes])
+@pytest.mark.parametrize("field", DEAL_FIELDS)
+def test_a_deal_value_is_refused_by_both_writers(writer: object, field: str) -> None:
+    bad = {**row(), field: "2 for $5.00" if field.endswith("description") else "5.00"}
+    with pytest.raises(ValueError, match="client rule for Walmart's deal fields"):
+        writer([row(), bad])  # type: ignore[operator]
+
+
+@pytest.mark.parametrize("writer", [canonical_products_bytes, products_csv_bytes])
+def test_order_extra_fields_and_types_are_refused(writer: object) -> None:
+    good = row()
+    with pytest.raises(ValueError):
+        writer([{**good, "points": ""}])  # type: ignore[operator]
+    with pytest.raises(ValueError):
+        writer([dict(reversed(list(good.items())))])  # type: ignore[operator]
+    with pytest.raises(ValueError):
+        writer([{**good, "upc": 12345}])  # type: ignore[operator, dict-item]
+
+
+def test_conforming_rows_are_written_in_the_22_field_order() -> None:
+    body = products_csv_bytes([row()]).decode("utf-8-sig").splitlines()
+    assert body[0].split(",") == list(OUTPUT_FIELDS)
+    assert b'"volume_deals_description": ""' in canonical_products_bytes(
+        [row()]
+    ) or b'"volume_deals_description":""' in canonical_products_bytes([row()])
diff --git a/tests/unit/test_filtered_views_168.py b/tests/unit/test_filtered_views_168.py
