+def test_a_refused_automatic_publication_is_an_error_with_a_non_zero_exit(env: Env) -> None:
+    """Release 1.6.6 (the client's review of 1.6.5): a validated, complete run whose automatic publication is
+    refused must not end as a quiet success. 1.6.5 logged PUBLICATION_REFUSED at WARN and exited 0, so neither
+    documented alert (any ERROR line; RUN_FINISHED with exit_code != 0) fired, and nothing was recorded on
+    the run."""
+    settings = env.config.parent / "settings.yaml"
+    text = settings.read_text(encoding="utf-8")
+    assert text.count("publication: { test_target: true }") == 1
+    # Not a test target: the mock's pages did not come from the network, so their publication is refused.
+    settings.write_text(
+        text.replace("publication: { test_target: true }", "publication: { test_target: false }"),
+        encoding="utf-8",
+    )
+    code, lines = env.cli("run", "--store", STORE_KEY)
+    [run] = env.runs()
+    assert run.status == "validated"  # the run itself is good: only its publication was refused
+    refused = [x for x in lines if x["event"] == "PUBLICATION_REFUSED"]
+    assert len(refused) == 1 and refused[0]["level"] == "ERROR", refused
+    assert "did not come from the network" in json.dumps(refused[0])
+    finished = [x for x in lines if x["event"] == "RUN_FINISHED"][-1]
+    assert code == 6 and finished["exit_code"] == 6 and finished["level"] == "WARN", finished
+    assert finished["publication"]["published"] is False
+    assert "did not come from the network" in finished["publication"]["refused"]
+    with sessionmaker(env.engine)() as s:
+        recorded = list(
+            s.scalars(select(Event).where(Event.run_id == run.id, Event.code == "PUBLICATION_REFUSED"))
+        )
+    assert [e.level for e in recorded] == ["ERROR"]
+    assert not (env.data / "published" / STORE_KEY / "latest.json").exists()  # nothing was published
+
