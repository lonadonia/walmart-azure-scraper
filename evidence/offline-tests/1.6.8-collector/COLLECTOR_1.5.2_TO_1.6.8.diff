+    ceiling(env)
+    n = {"calls": 0}
+
+    def cut(endpoint: str, body: dict[str, Any]) -> httpx.Response | None:
+        n["calls"] += 1
+        if n["calls"] == 1:
+            raise httpx.ReadTimeout("no answer (test)")
