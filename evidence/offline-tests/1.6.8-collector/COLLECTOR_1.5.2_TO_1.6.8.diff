+    assert res["summary"] == {"records": 26, "verified": 26, "mismatch": 0, "unverified": 0}
+    assert {r["source"]["page"] for r in res["results"]} == {FLAT}
+    assert all(r["page"]["pickup_at_store"] for r in res["results"])
