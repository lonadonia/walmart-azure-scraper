+def listing_key(url: str) -> str:
+    """Release 1.6.8: what a navigation link reaches, whatever the words of its path: its kind (a result
+    listing, ``browse``, or a category page of its own, ``cp``) and its own category ID. Walmart serves a
+    listing by that ID: live, the Health & Wellness page links
+    ``/browse/health-medicine/shop-all-cold-cough-flu-medicine/976760_4661388_6244277_7158394`` as "Cough"
+    and ``/browse/cold-cough-and-flu/shop-all-cold-cough-flu-medicine/976760_4661388_6244277_7158394`` as
+    "Subscription". "" for any other link, or one whose last segment is not a category ID."""
+    path = urlsplit(url).path
+    kind = "browse" if path.startswith("/browse/") else "cp" if path.startswith("/cp/") else ""
+    lid = wpd.listing_id(url)
+    return f"{kind}:{lid}" if kind and _CATEGORY_ID.fullmatch(lid) else ""
 
 
