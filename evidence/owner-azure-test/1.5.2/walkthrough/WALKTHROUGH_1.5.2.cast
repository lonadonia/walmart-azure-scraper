[30.563628, "o", "\r\n\u001b[1;36m# The store and the fulfillment: Walmart #3891, Waukegan, IL 60085, Pickup\u001b[0m\r\n"]
[33.065107, "o", "\u001b[1;32m$\u001b[0m sudo docker run --rm --network none --entrypoint cat walmart-collector:1.5.2-oxylabs /app/config/stores.yaml\r\n"]
[34.571426, "o", "# Walmart stores. location_id is the Walmart store number; expected.* are labels checked against\r\n# Walmart's own store page and page data at run time (the records take the name and address from Walmart,\r\n# never from this file). The same store collected for two fulfillment modes is two entries.\r\nstores:\r\n  - key: walmart-3891-pickup\r\n    retailer: walmart\r\n    enabled: true\r\n    location_id: \"3891\"\r\n    store_number: \"3891\"\r\n    expected: { display_name: \"Walmart #3891 Waukegan\", postal_code: \"60085\", address_line1: \"3900 Fountain Square Pl\" }\r\n    modality: PICKUP\r\n    timezone: America/Chicago\r\n    store_page_url: https://www.walmart.com/store/3891-waukegan-il\r\n    notes: Client-assigned store, 3900 Fountain Square Pl, Waukegan, IL 60085; Pickup prices.\r\n"]
[36.824742, "o", "\r\n\u001b[1;36m# The schedule is off in the configuration, and nothing on this VM starts the collector\u001b[0m\r\n"]
[39.326485, "o", "\u001b[1;32m$\u001b[0m sudo docker run --rm --network none --entrypoint grep walmart-collector:1.5.2-oxylabs -n -A2 'schedule:' /app/config/collector.yaml\r\n"]
[40.750367, "o", "40:    schedule:\r\n41-      enabled: false               # OFF until the client approves; read by `run --scheduled` (Azure starts the job)\r\n42-      weekdays: [1, 4]             # 0 = Monday ... 6 = Sunday: Tuesday and Friday\r\n"]
[42.993038, "o", "\u001b[1;32m$\u001b[0m systemctl list-timers --all --no-pager | grep -i -E 'walmart|collector' || echo 'no timer names the collector'\r\n"]
[44.010735, "o", "no timer names the collector\r\n"]
[46.012193, "o", "\u001b[1;32m$\u001b[0m (crontab -l; sudo crontab -l) 2>/dev/null | grep -i -E 'walmart|collector' || echo 'no cron entry names the collector'\r\n"]
[47.049448, "o", "no cron entry names the collector\r\n"]
[49.051058, "o", "\r\n\u001b[1;36m# Without a key, a run is refused before any request (exit 3: CREDENTIALS)\u001b[0m\r\n"]
