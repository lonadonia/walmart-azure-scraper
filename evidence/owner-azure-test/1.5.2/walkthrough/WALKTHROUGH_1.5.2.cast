[103.936622, "o", "\r\n\u001b[1;36m# Kill and resume, now: a new replay of S6's stored pages, killed with SIGKILL partway through, then resumed\u001b[0m\r\n"]
[106.438497, "o", "\r\n\u001b[1;36m# A run already replayed is not replayed again, so this uses a fresh copy of the campaign database, dropped afterwards\u001b[0m\r\n"]
[108.939924, "o", "\u001b[1;32m$\u001b[0m sudo docker exec v152pg createdb -U postgres walmart_walk && sudo docker exec -i v152pg pg_restore -U postgres --no-owner --no-privileges -d walmart_walk < pkg/campaign_copy.dump && echo 'restored: walmart_walk'\r\n"]
[112.568066, "o", "restored: walmart_walk\r\n"]
[114.657974, "o", "\u001b[1;32m$\u001b[0m sudo docker run -d --name v152walk --network v152net -v v152data:/app/data -e WALMART_COLLECTOR_DATABASE_URL=postgresql+psycopg://postgres@v152pg/walmart_walk walmart-collector:1.5.2-oxylabs replay --run 01M6A2VQAA5VXJHJHMZPCTZTD4\r\n"]
