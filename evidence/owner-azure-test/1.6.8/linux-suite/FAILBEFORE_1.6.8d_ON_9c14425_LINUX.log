                    "name": "Clearance",
                    "url": W + "/browse/food/976759?facet=special_offers%3AClearance",
                    "seen": [],
                }
            )
            task.cursor = cursor
            s.commit()
        report = coverage(env, run)
        rows = {r["listing_id"]: r for r in report["rows"]}
        milk_row, own_row = rows["976759_9176907"], rows["976759"]
