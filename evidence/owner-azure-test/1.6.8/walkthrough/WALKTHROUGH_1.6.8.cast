[261.151212, "o", "\r\n\u001b[1;36m# Pause and resume: a new replay of L10 from its stored pages, killed with SIGKILL partway through, then resumed by the ordinary command\u001b[0m\r\n"]
[263.693761, "o", "\u001b[1;32m$\u001b[0m dk run -d --name q168dwalkreplay --network host --read-only --tmpfs /tmp -v q168dwalk:/app/data --env-file \"$D/pg.env\" -e WALMART_COLLECTOR_DATABASE_URL=$(url walmart_q168d_walk) -e HTTP_PROXY=http://127.0.0.1:9 -e HTTPS_PROXY=http://127.0.0.1:9 -e NO_PROXY=127.0.0.1,localhost walmart-collector-q168d:1.6.8-oxylabs replay --run 01M6KA3CKYJSD6WDY4TDAAV73Y | cut -c1-12\r\n"]
[264.922983, "o", "869dfa4051a1\r\n"]
[295.462018, "o", "\u001b[1;32m$\u001b[0m dk kill --signal=KILL q168dwalkreplay > /dev/null; psqlq walmart_q168d_walk \"select 'pages read when killed: ' || count(*) from page_fetches where run_id = '01M6PZA58463PEE3DNJEYAHTNX'\"\r\n"]
