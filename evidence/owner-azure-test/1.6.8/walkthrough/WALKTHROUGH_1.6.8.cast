[29.569079, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none --entrypoint cat walmart-collector-q168d:1.6.8-oxylabs /app/BUILD_INFO.json; echo\r\n"]
[30.936253, "o", "{\"commit\": \"85c29e7b2404500299056973f50c84b84e187a5a\", \"built_at\": \"2026-11-05T22:58:08Z\"}\r\n"]
[31.122834, "o", "\r\n"]
[33.123844, "o", "\r\n\u001b[1;36m# The store and the fulfillment: Walmart #3891, 3900 Fountain Square Pl, Waukegan, IL 60085, Pickup\u001b[0m\r\n"]
[35.62556, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none --entrypoint cat walmart-collector-q168d:1.6.8-oxylabs /app/config/stores.yaml\r\n"]
[37.020494, "o", "# Walmart stores. location_id is the Walmart store number; expected.* are labels checked against\r\n# Walmart's own store page and page data at run time (the records take the name and address from Walmart,\r\n# never from this file). The same store collected for two fulfillment modes is two entries.\r\nstores:\r\n  - key: walmart-3891-pickup\r\n    retailer: walmart\r\n    enabled: true\r\n    location_id: \"3891\"\r\n    store_number: \"3891\"\r\n    expected: { display_name: \"Walmart #3891 Waukegan\", postal_code: \"60085\", address_line1: \"3900 Fountain Square Pl\" }\r\n    modality: PICKUP\r\n    timezone: America/Chicago\r\n    store_page_url: https://www.walmart.com/store/3891-waukegan-il\r\n    notes: Client-assigned store, 3900 Fountain Square Pl, Waukegan, IL 60085; Pickup prices.\r\n"]
[39.19719, "o", "\r\n\u001b[1;36m# The schedule is off in the configuration, and nothing on this VM starts the collector\u001b[0m\r\n"]
[41.699018, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none --entrypoint grep walmart-collector-q168d:1.6.8-oxylabs -n -A2 'schedule:' /app/config/collector.yaml\r\n"]
[43.129768, "o", "40:    schedule:\r\n41-      enabled: false               # OFF until the client approves; read by `run --scheduled` (Azure starts the job)\r\n42-      weekdays: [1, 4]             # 0 = Monday ... 6 = Sunday: Tuesday and Friday\r\n"]
[45.296168, "o", "\u001b[1;32m$\u001b[0m systemctl list-timers --all --no-pager | grep -i -E 'walmart|collector' || echo 'no timer names the collector'\r\n"]
[46.31498, "o", "no timer names the collector\r\n"]
[48.316392, "o", "\u001b[1;32m$\u001b[0m (crontab -l; sudo -n crontab -l) 2>/dev/null | grep -i -E 'walmart|collector' || echo 'no cron entry names the collector'\r\n"]
[49.338767, "o", "no cron entry names the collector\r\n"]
[51.339978, "o", "\r\n\u001b[1;36m# Without a provider key, a run is refused before any request (exit 3: CREDENTIALS)\u001b[0m\r\n"]
[53.841783, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none walmart-collector-q168d:1.6.8-oxylabs validate-config --require-credentials | python3 walkview.py environment.oxylabs_key\r\n"]
[56.801121, "o", "exit_code 3 | command validate-config\r\n"]
[56.801357, "o", "environment.oxylabs_key: {\"configured\": false, \"fingerprint\": null, \"source\": null, \"api\": \"Oxylabs Web API (Bearer key); the Classic Web Scraper API is another product\"}\r\n"]
[58.807084, "o", "\r\n\u001b[1;36m# A copy of the campaign database and of the stored pages of live runs L10 and L12, for this recording only (removed at the end)\u001b[0m\r\n"]
[61.308821, "o", "\u001b[1;32m$\u001b[0m sudo -n -u postgres createdb -O walmart_q167 walmart_q168d_walk && pg_restore -h 127.0.0.1 -U walmart_q167 -d walmart_q168d_walk --no-owner --no-privileges --exit-on-error ~/q167/campaign_live150.dump && echo restored: walmart_q168d_walk\r\n"]
[80.888996, "o", "restored: walmart_q168d_walk\r\n"]
[82.890478, "o", "\u001b[1;32m$\u001b[0m dk volume create q168dwalk && dk run --rm --network none -v q168dwalk:/app/data -v \"$D/in:/in:ro\" --entrypoint tar walmart-collector-q168d:1.6.8-oxylabs -xf /in/stored_live_L10_L12.tar -C /app/data && echo loaded\r\n"]
[84.06398, "o", "q168dwalk\r\n"]
[90.79355, "o", "loaded\r\n"]
[92.795128, "o", "\r\n\u001b[1;36m# The schema: checked, and brought to the release's head (an upgrade that has nothing to do changes nothing)\u001b[0m\r\n"]
[95.296826, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- db-upgrade | python3 walkview.py\r\n"]
[98.439757, "o", "exit_code 0 | command db-upgrade\r\n"]
[100.445882, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- validate-config --check-db | python3 walkview.py database\r\n"]
[103.400906, "o", "exit_code 0 | command validate-config\r\n"]
[103.401103, "o", "database: {\"revision\": \"0006\", \"head\": \"0006\", \"current\": true}\r\n"]
[105.406765, "o", "\r\n\u001b[1;36m# Start: live run L12 (2026-11-04, release 1.6.6) replayed from its stored pages by 1.6.8. A replay makes no request and is never published\u001b[0m\r\n"]
[107.908712, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- replay --run 01M6MC7YE4PBXV88G3PJ5ENW4B | python3 walkview.py\r\n"]
[218.637172, "o", "exit_code 0 | command replay\r\n"]
[220.781505, "o", "\r\n\u001b[1;36m# Status of that run: its outcome, its records, and where its files are kept\u001b[0m\r\n"]
[223.283025, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- status --run 01M6PZ5D60AHVHEJ2END6RDGSB | python3 walkview.py run.status run.records_by_status run.collection_complete run.lineage.basis\r\n"]
[227.83836, "o", "exit_code 0 | command status\r\n"]
[227.838474, "o", "run.status: \"rejected\"\r\nrun.records_by_status: {\"valid\": 40, \"historical\": 10261}\r\nrun.collection_complete: false\r\nrun.lineage.basis: \"replay of 01M6MC7YE4PBXV88G3PJ5ENW4B: recorded by the run\"\r\n"]
[229.844496, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none -v q168dwalk:/app/data --entrypoint sh walmart-collector-q168d:1.6.8-oxylabs -c 'find /app/data/runs -maxdepth 2 | head -5'\r\n"]
[231.330949, "o", "/app/data/runs\r\n/app/data/runs/walmart-3891-pickup\r\n/app/data/runs/walmart-3891-pickup/01M6KA3CKYJSD6WDY4TDAAV73Y\r\n/app/data/runs/walmart-3891-pickup/01M6MC7YE4PBXV88G3PJ5ENW4B\r\n/app/data/runs/walmart-3891-pickup/01M6PZ5D60AHVHEJ2END6RDGSB\r\n"]
[233.547264, "o", "\r\n\u001b[1;36m# Export: the files of the run, and the 22 columns in the agreed order\u001b[0m\r\n"]
[236.04912, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- export --run 01M6PZ5D60AHVHEJ2END6RDGSB --out /app/data/walk/export | python3 walkview.py out files verified\r\n"]
[243.139042, "o", "exit_code 0 | command export\r\nout: \"/app/data/walk/export\"\r\nfiles: [\"products.json\", \"products.csv\", \"memberships.json\", \"offers.json\", \"provenance.json\", \"validation_report.json\", \"products_fresh.json\", \"products_fresh.csv\", \"record_map.json\", \"field_dispositions.json\", \"field_dispositions.csv\", \"manifest.json\"]\r\nverified: true\r\n"]
[245.143612, "o", "\u001b[1;32m$\u001b[0m dk run --rm --network none -v q168dwalk:/app/data --entrypoint sh walmart-collector-q168d:1.6.8-oxylabs -c 'head -1 /app/data/walk/export/products.csv | tr , \"\\n\" | nl | paste - - - -'\r\n"]
