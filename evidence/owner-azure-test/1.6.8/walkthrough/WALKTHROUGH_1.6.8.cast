[248.69126, "o", "\r\n\u001b[1;36m# Coverage under 1.6.8 of live run L10 as it was collected (2026-11-04, release 1.6.4, a pilot with page limits)\u001b[0m\r\n"]
[251.19284, "o", "\r\n\u001b[1;36m# A row is complete only when every listing of it is; a /cp/ subcategory page an earlier release skipped keeps its row open\u001b[0m\r\n"]
[253.694574, "o", "\u001b[1;32m$\u001b[0m cdb oxylabs q168dwalk walmart_q168d_walk -- coverage-report --run 01M6KA3CKYJSD6WDY4TDAAV73Y --out /app/data/walk/coverage_L10 | python3 walkview.py coverage_complete csv_rows_complete csv_rows\r\n"]
[259.145458, "o", "exit_code 0 | command coverage-report\r\n"]
