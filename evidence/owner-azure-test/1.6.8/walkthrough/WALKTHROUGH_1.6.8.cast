[6.010498, "o", "Linux 7.0.0-1017-azure x86_64\r\n"]
[8.012018, "o", "\u001b[1;32m$\u001b[0m sha256sum WALMART_OXYLABS_SOURCE_1.6.8.zip WALMART_SCRAPEDO_SOURCE_1.6.8.zip\r\n"]
